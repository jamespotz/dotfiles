layout {

    focus-ring {
        active-color   "#9dcbfb"
        inactive-color "#000000"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#9dcbfb"
        inactive-color "#000000"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#9dcbfb"
        inactive-color "#124a73"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#9dcbfb80"
    }
}

recent-windows {
    highlight {
        active-color "#9dcbfb"
        urgent-color "#ffb4ab"
    }
}
