#!/usr/bin/env bash

# Force scrcpy to use Wayland for the preview window
export SDL_VIDEODRIVER=wayland

# 1. Look for "Virtual Camera" (matches your current output)
VIDEO_DEV=$(v4l2-ctl --list-devices 2>/dev/null | grep -A 1 "Virtual Camera" | tail -n 1 | xargs)

# 2. Fallback: Look for "AndroidCam" 
if [ -z "$VIDEO_DEV" ]; then
    VIDEO_DEV=$(v4l2-ctl --list-devices 2>/dev/null | grep -A 1 "AndroidCam" | tail -n 1 | xargs)
fi

# 3. Fallback: Load module if it disappeared
if [ -z "$VIDEO_DEV" ]; then
    echo "⚠️ Virtual camera device not found. Attempting to start it..."
    sudo modprobe v4l2loopback exclusive_caps=1 card_label="Virtual Camera"
    sleep 1
    VIDEO_DEV=$(v4l2-ctl --list-devices 2>/dev/null | grep -A 1 "Virtual Camera" | tail -n 1 | xargs)
fi

# Exit if everything fails
if [ -z "$VIDEO_DEV" ]; then
    echo "❌ Error: Could not find or create a v4l2loopback video device."
    exit 1
fi

echo "🚀 Starting High-Performance Android Camera stream to $VIDEO_DEV..."

# HIGH PERFORMANCE ARGUMENTS USED BELOW:
# --video-codec=h265         -> Hardware accelerated encoding (uses less phone CPU)
# --video-bit-rate=16M       -> Sharp image quality with minimal pixelation
# --max-fps=60               -> Silky smooth motion capture
# --camera-size=1920x1080    -> Forces sharp full HD stream
# --no-audio		     -> No audio

scrcpy \
  --video-source=camera \
  --v4l2-sink="$VIDEO_DEV" \
  --video-codec=h265 \
  --video-bit-rate=16M \
  --max-fps=60 \
  --camera-size=1920x1080 \
  --no-audio \
  "$@"
